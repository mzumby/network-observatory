{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agentmarkit-network-observatory-connect",
  "account_id": "1e8cfc7ef84fbb46a6efa51fe89822e8",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "connect.agentmarkit.com",
      "custom_domain": true
    }
  ],
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "COMPOSIO_GMAIL_AUTH_CONFIG_ID": "ac_L1ocbuUoUtaE"
  },
  "secrets": {
    "required": [
      "COMPOSIO_API_KEY",
      "INVITE_ADMIN_TOKEN",
      "IDENTITY_PEPPER"
    ]
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentmarkit-network-observatory-connect",
      "database_id": "c9e88bce-f694-4a6b-80c9-79109cb494aa",
      "migrations_dir": "./drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
